# --- Contexto de trabajo local (nunca se publica) ---
Contexto/
CLAUDE.md
.claude/
.cursor/
NOTAS*.md

# --- Datos de entrada (no son nuestros y pesan) ---
data/raw/
data/videos/
data/labeling/

# La exportacion de la herramienta de anotacion es un intermedio: data/dataset la
# reemplaza con la particion correcta, agrupada por video.
data/export/

# Los frames del conjunto de entrenamiento NO se versionan, y es deliberado:
#
#   1. Son material del cliente. El repositorio es publico, y redistribuir su
#      metraje no es algo que corresponda decidir aqui.
#   2. Se regeneran de forma determinista: prepare_labeling_set.py con la semilla
#      fijada produce exactamente los mismos 171 frames.
#
# Las ANOTACIONES si se versionan (data/dataset/labels): son dos horas de trabajo
# manual, no se regeneran de ninguna forma, y pesan 166 KB. Con ellas y el script,
# el entrenamiento es reproducible sin publicar el metraje.
data/dataset/images/
*.mp4
*.avi
*.mov
*.mkv
!output_ejemplo/**/*.mp4

# --- Pesos ---
# Se versionan SOLO los que la imagen necesita para funcionar out-of-the-box.
# El enunciado exige que el contenedor arranque sin descargas manuales, asi que
# los pesos tienen que viajar con el repositorio: el evaluador construye la imagen
# desde este arbol y no tiene de donde sacarlos si no estan aca.
*.pt
*.pth
*.onnx
*.engine
weights/*
!weights/.gitkeep
!weights/detector_v1.pt
!weights/yolo11s.pt

# --- Salidas de ejecucion ---
output/
runs/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Entorno / editores / SO ---
.env
.env.*
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store
