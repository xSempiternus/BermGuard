# --- Contexto de trabajo local (nunca se publica) ---
Contexto/
CLAUDE.md
.claude/
.cursor/
NOTAS*.md

# --- Datos de entrada (no son nuestros y pesan) ---
data/raw/
data/videos/
data/labeling/
*.mp4
*.avi
*.mov
*.mkv
!output_ejemplo/**/*.mp4

# --- Pesos ---
# Se versionan SOLO los que la imagen necesita para funcionar out-of-the-box.
# El enunciado exige que el contenedor arranque sin descargas manuales, asi que
# los pesos tienen que viajar con el repositorio: el evaluador construye la imagen
# desde este arbol y no tiene de donde sacarlos si no estan aca.
*.pt
*.pth
*.onnx
*.engine
weights/*
!weights/.gitkeep
!weights/detector_v1.pt
!weights/yolo11s.pt

# --- Salidas de ejecucion ---
output/
runs/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Entorno / editores / SO ---
.env
.env.*
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store
