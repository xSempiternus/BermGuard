# Contexto de trabajo local: nunca debe entrar a la imagen
Contexto/
CLAUDE.md
.claude/

# Datos y salidas: llegan por volumen montado, no horneados
data/
output/
output_ejemplo/
*.mp4
*.avi
*.mov
*.mkv

# Entorno de desarrollo
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Herramientas de desarrollo y documentacion: no las necesita el runtime, y
# excluirlas reduce el contexto de build y por tanto el tiempo de transferencia
scripts/
tests/
docs/
.git/
.github/
.gitignore
README.md
reporte_benchmark.md

# Artefactos de entrenamiento y pesos que el runtime no usa.
# weights/clip son 338 MB del encoder de texto que descargo YOLO-World durante la
# evaluacion del enfoque zero-shot (ADR 0002). Ese enfoque quedo descartado y el
# pipeline no lo importa, asi que no tiene por que engordar la imagen.
weights/training/
weights/clip/
weights/yolov8s-worldv2.pt
weights/yolo26n.pt
runs/
*.onnx
*.engine
